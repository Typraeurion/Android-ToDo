<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Invisible box for sizing -->
    <item
        android:gravity="center"
        android:width="30dp"
        android:height="30dp">
      <shape android:shape="rectangle">
        <solid android:color="#00808080" />
      </shape>
    </item>
    <!-- Drop shadow -->
    <item
        android:gravity="center"
        android:width="26dp"
        android:height="26dp"
        android:top="2dp">
        <shape android:shape="rectangle">
            <!-- 1-point (approximate) corner rounding -->
            <corners android:radius="3.5dp" />
            <gradient android:type="radial"
                android:gradientRadius="15dp"
                android:startColor="#55000000"
                android:centerY="0.75"
                android:endColor="#00000000" />
        </shape>
    </item>
    <!-- The base button -->
    <item
        android:gravity="center"
        android:width="25dp"
        android:height="25dp">
        <shape android:shape="rectangle">
            <!-- 1-pixel black border -->
            <stroke android:width="1dp"
                android:color="#c0000000"/>
            <!-- 1-point (approximate) corner rounding -->
            <corners android:radius="2.5dp"/>
            <!-- Gradient centered 3/4 of the way down.  Originally this
                 was a radial gradient extended beyond the boundaries on
                 a vertical rectangle, which made it appear linear when
                 stretched (from a 9-patch) with highlights around the edges. -->
            <gradient
                android:type="linear"
                android:angle="270"
                android:startColor="#f3f3f3"
                android:centerY="0.75"
                android:centerColor="#bababa"
                android:endColor="#d8d8d8"/>
        </shape>
    </item>
    <!-- Side lightening.  Here we need to use a separate gradient
         for each side which only transitions close to the edge. -->
    <item
        android:gravity="center"
        android:width="25dp"
        android:height="25dp">
        <shape android:shape="rectangle">
            <corners android:radius="2.5dp"/>
            <gradient
                android:type="linear"
                android:angle="0"
                android:startColor="#20ffffff"
                android:centerX="0.125"
                android:centerColor="#00ffffff"
                android:endColor="#00ffffff"/>
        </shape>
    </item>
    <item
        android:gravity="center"
        android:width="25dp"
        android:height="25dp">
        <shape android:shape="rectangle">
            <corners android:radius="2.5dp"/>
            <gradient
                android:type="linear"
                android:angle="0"
                android:startColor="#00ffffff"
                android:centerX="0.875"
                android:centerColor="#00ffffff"
                android:endColor="#20ffffff"/>
        </shape>
    </item>
    <!-- Checkmark -->
    <item
        android:gravity="center"
        android:width="30dp"
        android:height="30dp">
      <vector
        android:width="30dp"
        android:height="30dp"
        android:viewportWidth="47.5"
        android:viewportHeight="47.5">
        <path
            android:pathData="m 16.25,17.5 c 2.3,1.7875 4.7125,5.1125 5.9125,7.55 C 25.9,20.525 35,7.7125 47.05,1.4625 37.0375,10.425 30.8375,23.65 21.1875,32.4375 19.375,28.2625 14.5875,22.5375 12.4375,21.1375 13.4375,20 14.875,18.5875 16.25,17.4 Z"
            android:fillColor="#ff000000"
            android:strokeColor="#00ffffff" />
      </vector>
    </item>
</layer-list>
